{
  "name": "sitestack",
  "private": true,
  "version": "1.1.2",
  "description": "Know what's powering any website — High-precision technology intelligence Chrome extension.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web:css": "tailwindcss --config tailwind.config.js -i packages/web/src/styles/input.css -o dist-web/assets/style.css --minify",
    "build:web:html": "vite-node packages/web/src/build.ts",
    "build:web": "npm run build:web:css && npm run build:web:html",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bench": "vitest run tests/engine/benchmark.test.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vite-node": "^2.1.8",
    "vitest": "^2.1.8"
  }
}
